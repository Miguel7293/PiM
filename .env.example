# Copia este archivo a .env y rellena tus claves. El .env real NO se versiona.

# Modelos en la nube (opcional: solo si el cliente usa IA en la nube)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modelo local opcional (p. ej. Ollama)
OLLAMA_HOST=http://localhost:11434

# Interfaz enlazada a localhost por defecto
PIM_ADDR=127.0.0.1:8787
